# Endereço público HTTPS estável da aplicação (usado em OAuth e links).
APP_URL=https://www.maricoachfit.com

# Conexão com o PostgreSQL do Coolify pela rede interna.
# Formato: postgres://USUARIO:SENHA@HOST_INTERNO:5432/BANCO
DATABASE_URL=postgres://usuario:senha@host-interno:5432/marichat

# Senha do painel administrativo (usuário fixo: admin).
ADMIN_PASSWORD=troque-por-uma-senha-longa

# App Meta (Instagram API com Instagram Login).
INSTAGRAM_APP_ID=000000000000000
INSTAGRAM_APP_SECRET=troque-pelo-app-secret

# Opcional: sobrescreve a URL de retorno do OAuth.
# Padrão: ${APP_URL}/api/auth/instagram/callback
# INSTAGRAM_OAUTH_REDIRECT_URI=https://www.maricoachfit.com/api/auth/instagram/callback

# Token definido por você no painel da Meta ao configurar o webhook.
META_WEBHOOK_VERIFY_TOKEN=troque-por-um-token-aleatorio

# Chave de 32 bytes em base64 que cifra o token do Instagram (AES-256-GCM).
# Gere uma vez e nunca troque sem reconectar a conta.
# Node: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=troque-por-32-bytes-em-base64

# Segredo da tarefa agendada do Coolify (Authorization: Bearer <valor>).
CRON_SECRET=troque-por-um-segredo-aleatorio

# E-mail exibido nas páginas públicas de privacidade/exclusão de dados.
PRIVACY_CONTACT_EMAIL=privacidade@exemplo.com

# Opcional: sobrescreve a versão da Graph API usada (padrão v26.0).
# INSTAGRAM_API_VERSION=v26.0
